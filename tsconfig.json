{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "exclude": [
    "supabase/functions",
    "**/__tests__/**",
    "jest.setup.ts",
    "jest.config.js",
    "metro.config.js",
    "babel.config.js"
  ]
}
