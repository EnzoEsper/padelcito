EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth (Supabase Auth signInWithIdToken). Web client is required on all platforms.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# iOS OAuth client from Google Cloud (bundle com.padelcito.app). Required for iOS builds and runtime.
# Also set in EAS development environment so the config plugin embeds the URL scheme at build time.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Google Maps SDK (Android map tiles in react-native-maps). Restrict by package + SHA-1 in Google Cloud.
# Not required on iOS (Apple Maps). Set in EAS development environment for Android cloud builds.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional runtime error reporting (see src/lib/sentry.ts). DSN only — no upload secrets in the app.
# EXPO_PUBLIC_SENTRY_DSN=

# EAS production only — enables @sentry/react-native/expo upload hooks (never commit SENTRY_AUTH_TOKEN):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Set only in Supabase Edge Function secrets (never in the app bundle):
# GOOGLE_PLACES_API_KEY=
