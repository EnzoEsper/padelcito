{
  "expo": {
    "name": "padelcito",
    "slug": "padelcito",
    "scheme": "padelcito",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.padelcito.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.padelcito.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Padelcito usa tu ubicación para encontrar partidos de padel cercanos."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Padelcito needs access to your photos so you can upload tournament and training flyers.",
          "cameraPermission": "Padelcito needs camera access so you can photograph flyers to publish."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b8bd01e1-57c9-4822-b7c8-b04f8df26c52"
      }
    }
  }
}
